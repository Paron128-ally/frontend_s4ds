# Copy to .env.local and adjust. Restart `npm run dev` after changing (values are inlined at build time).

# true  (default) -> run entirely on built-in mock data, no backend needed
# false           -> call the real backend at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the backend API (see API_CONTRACT.md). Default matches `npm run mock:api`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
