  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Health check endpoint for Docker and monitoring systems.\n\nReturns:\n    APIResponse[HealthResponse]: Status of the application",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIResponse_HealthResponse_"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests - Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/ingest": {
      "post": {
        "tags": [
          "Ingest"
        ],
        "summary": "Ingest Teams",
        "description": "Validate cohort, persist run + teams, score in background.",
        "operationId": "ingest_teams",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIResponse_IngestResponse_"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests - Rate limit exceeded"
          },
          "422": {
            "description": "Validation Error",
